#!/usr/bin/env bash
# omarchy-rdp: RDP Connection Manager for Omarchy

set -euo pipefail

# Resolve symlinks to locate library directory reliably
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [[ -d "$SCRIPT_DIR/../lib/omarchy-rdp" ]]; then
  LIB_DIR="$SCRIPT_DIR/../lib/omarchy-rdp"
elif [[ -d "$SCRIPT_DIR/../lib" ]]; then
  LIB_DIR="$SCRIPT_DIR/../lib"
elif [[ -d "/usr/lib/omarchy-rdp" ]]; then
  LIB_DIR="/usr/lib/omarchy-rdp"
else
  echo "Error: Could not locate omarchy-rdp library directory" >&2
  exit 1
fi

source "$LIB_DIR/config.sh"
source "$LIB_DIR/keyring.sh"
source "$LIB_DIR/rdp.sh"
source "$LIB_DIR/ui.sh"

show_help() {
  cat << 'HELP_EOF'
omarchy-rdp: Terminal RDP Connection Manager for Omarchy

Usage:
  omarchy-rdp [options]

Commands:
  --list                       List all saved profile names
  --get <name>                 Output profile JSON
  --add <json>                 Add or update a profile from JSON string
  --delete <name>              Delete a profile and its stored credential
  --set-password <name> <pass> Store credential in Linux Keyring for profile
  --get-password <name>        Retrieve credential from Linux Keyring
  --get-args <name> [--show-secrets] Print generated FreeRDP 3 arguments (password masked by default)
  --connect <name>             Launch RDP session for profile directly
  --watchdog <name>            Internal background runner monitoring session lifecycle
  --version, -v                Print version
  --help, -h                   Show this help message

Interactive:
  Run without arguments to launch the interactive TUI.
HELP_EOF
}

case "${1:-}" in
  --list)
    config_list_profiles
    ;;
  --get)
    if [[ -z "${2:-}" ]]; then
      echo "Error: Missing profile name" >&2
      exit 1
    fi
    config_get_profile "$2"
    ;;
  --add)
    if [[ -z "${2:-}" ]]; then
      echo "Error: Missing profile JSON" >&2
      exit 1
    fi
    config_save_profile "$2"
    ;;
  --delete)
    if [[ -z "${2:-}" ]]; then
      echo "Error: Missing profile name" >&2
      exit 1
    fi
    config_delete_profile "$2"
    keyring_delete_password "$2"
    ;;
  --set-password|--set-credential)
    if [[ -z "${2:-}" || -z "${3:-}" ]]; then
      echo "Error: Usage: $1 <profile_name> <password>" >&2
      exit 1
    fi
    keyring_set_password "$2" "$3"
    ;;
  --get-password|--get-credential)
    if [[ -z "${2:-}" ]]; then
      echo "Error: Missing profile name" >&2
      exit 1
    fi
    keyring_get_password "$2"
    ;;
  --get-args)
    if [[ -z "${2:-}" ]]; then
      echo "Error: Missing profile name" >&2
      exit 1
    fi
    prof="$(config_get_profile "$2")"
    if [[ -z "$prof" || "$prof" == "null" ]]; then
      echo "Error: Profile '$2' not found" >&2
      exit 1
    fi
    cred="$(keyring_get_password "$2" || true)"
    if [[ "${3:-}" == "--show-secrets" || "${3:-}" == "--raw" ]]; then
      rdp_build_args "$prof" "$cred" false
    else
      rdp_build_args "$prof" "$cred" true
    fi
    ;;
  --connect)
    if [[ -z "${2:-}" ]]; then
      echo "Error: Missing profile name" >&2
      exit 1
    fi
    prof="$(config_get_profile "$2")"
    if [[ -z "$prof" || "$prof" == "null" ]]; then
      echo "Error: Profile '$2' not found" >&2
      exit 1
    fi
    cred="$(keyring_get_password "$2" || true)"
    if [[ -z "$cred" && -t 0 ]]; then
      if command -v gum >/dev/null 2>&1; then
        cred="$(gum input --password --placeholder "Mot de passe pour $(echo "$prof" | jq -r .username)")"
        if gum confirm "Enregistrer ce credential dans le trousseau de clés ?"; then
          keyring_set_password "$2" "$cred"
        fi
      else
        read -rsp "Mot de passe: " cred
        echo
      fi
    fi
    rdp_execute_session "$prof" "$cred"
    ;;
  --watchdog)
    if [[ -z "${2:-}" ]]; then
      exit 1
    fi
    prof_name="$2"
    shift 2
    cred_file=""
    cred=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --credential-file)
          cred_file="${2:-}"
          shift 2
          ;;
        *)
          cred="$1"
          shift
          ;;
      esac
    done

    prof="$(config_get_profile "$prof_name")"
    if [[ -z "$prof" || "$prof" == "null" ]]; then
      exit 1
    fi

    if [[ -n "$cred_file" && -f "$cred_file" ]]; then
      cred="$(cat "$cred_file" 2>/dev/null || true)"
      rm -f "$cred_file"
    fi

    if [[ -z "$cred" ]]; then
      cred="$(keyring_get_password "$prof_name" || true)"
    fi

    start_time="$(date +%s)"
    exit_code=0
    rdp_execute_session "$prof" "$cred" || exit_code=$?
    end_time="$(date +%s)"
    duration=$((end_time - start_time))

    if (( exit_code != 0 || duration < 3 )); then
      ui_notify_error "La session '$prof_name' s'est fermée anormalement (durée: ${duration}s, code: $exit_code)."
      if command -v foot >/dev/null 2>&1; then
        foot --app-id=omarchy-rdp -e "$SCRIPT_DIR/omarchy-rdp" &
      fi
    fi
    exit 0
    ;;
  --version|-v)
    echo "omarchy-rdp 1.0.3"
    ;;
  --help|-h)
    show_help
    ;;
  "")
    ui_main_loop
    ;;
  *)
    echo "Unknown option: $1" >&2
    show_help >&2
    exit 1
    ;;
esac
