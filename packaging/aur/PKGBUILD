# Maintainer: PouletTendre <https://github.com/PouletTendre>
pkgname=omarchy-rdp
pkgver=1.0.0
pkgrel=1
pkgdesc="Interactive Terminal RDP Connection Manager for Omarchy and Hyprland"
arch=('any')
url="https://github.com/PouletTendre/omarchy-rdp"
license=('MIT')
depends=('bash' 'jq' 'gum' 'fzf' 'freerdp' 'libsecret' 'foot')
makedepends=('git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 bin/omarchy-rdp "$pkgdir/usr/bin/omarchy-rdp"
  install -d "$pkgdir/usr/lib/omarchy-rdp"
  install -m755 lib/*.sh "$pkgdir/usr/lib/omarchy-rdp/"
  install -Dm644 desktop/omarchy-rdp.desktop "$pkgdir/usr/share/applications/omarchy-rdp.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
